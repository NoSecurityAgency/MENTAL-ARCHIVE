<title>MENTAL ARCHIVE — NO SECURITY AGENCY</title>

<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background:
        radial-gradient(circle at center, #101010 0%, #050505 50%, #000 100%);
    color: #cfcfcf;
    font-family: "Courier New", monospace;
}

.container {
    width: 90%;
    max-width: 1050px;
    margin: auto;
    padding: 45px 0 80px;
}

/* HEADER */

.header {
    border-bottom: 1px solid #333;
    padding-bottom: 25px;
    margin-bottom: 45px;
}

.header h1 {
    margin: 0;
    font-size: 34px;
    letter-spacing: 5px;
    color: #e5e5e5;
}

.header .subtitle {
    margin-top: 12px;
    color: #666;
    font-size: 13px;
}

.status {
    margin-top: 20px;
    display: inline-block;
    border: 1px solid #333;
    padding: 7px 12px;
    font-size: 11px;
    color: #777;
}

/* SECTIONS */

.section {
    margin-bottom: 55px;
}

.section h2 {
    color: #ddd;
    font-size: 20px;
    letter-spacing: 3px;
    border-left: 3px solid #666;
    padding-left: 12px;
    margin-bottom: 22px;
}

.section h3 {
    color: #aaa;
    letter-spacing: 2px;
    font-size: 15px;
}

.section p {
    color: #929292;
    font-size: 14px;
    line-height: 1.85;
}

