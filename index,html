    color: #c7c7c7;
}

/* INFO BOX */

.info-box {
    border: 1px solid #292929;
    background: rgba(10,10,10,0.8);
    padding: 25px;
    margin: 25px 0;
}

.info-box .label {
    color: #555;
    font-size: 10px;
    letter-spacing: 2px;
    margin-bottom: 8px;
}

.info-box .value {
    color: #aaa;
    font-size: 14px;
}

/* STEPS */

.process {
    border-left: 1px solid #333;
    padding-left: 25px;
}

.process-item {
    margin-bottom: 35px;
    position: relative;
}

.process-item::before {
    content: "";
    position: absolute;
    width: 7px;
    height: 7px;
    background: #777;
    left: -29px;
    top: 5px;
}

.process-item h3 {
    margin-top: 0;
    color: #ccc;
}

.process-item p {
    margin-bottom: 0;
}

/* WARNING */

.warning {
    border: 1px solid #3a3a3a;
    background: #080808;
    padding: 25px;
    margin-top: 30px;
}

.warning-title {
    color: #aaa;
    letter-spacing: 3px;
    font-size: 13px;
    margin-bottom: 15px;
}

.warning p {
    color: #777;
}

/* CLASSIFIED */

.classified {
    color: #050505 !important;
    background: #050505;
    user-select: none;
}

/* FOOTER */

footer {
    border-top: 1px solid #222;
    text-align: center;
    padding: 35px 10px;
    color: #3f3f3f;
    font-size: 10px;
    line-height: 1.7;
}

/* HIDDEN CODE */

.hidden-code {
    position: fixed;
    bottom: 4px;
    right: 5px;

    font-family: "Courier New", monospace;
